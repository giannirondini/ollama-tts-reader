#!/usr/bin/perl
# unwrap-text — turn hard-wrapped text (PDFs, emails, terminals, code comments)
# into flowing paragraphs that a TTS model reads naturally.
#
#   stdin  : raw selected text
#   stdout : one paragraph per line-group, paragraphs separated by a blank line
#
# Rules
#   - blank line            => paragraph break (kept)
#   - single newline        => joined with a space
#   - "word-\nnext"         => "wordnext" (de-hyphenation, only before lowercase)
#   - list items (-, *, •, 1., a)) start a new line instead of being joined
#   - a prefix shared by every line of a paragraph (> quotes, // or # comments) is stripped
#   - lines/items without closing punctuation get a period, so the voice pauses
use strict;
use warnings;
use utf8;

binmode STDIN,  ':encoding(UTF-8)';
binmode STDOUT, ':encoding(UTF-8)';

local $/;
my $text = <STDIN> // '';

$text =~ s/\r\n?/\n/g;
$text =~ s/\x{00AD}//g;               # soft hyphens from PDFs
$text =~ s/[\x{2028}\x{2029}]/\n/g;   # Unicode line/paragraph separators
$text =~ s/\x{00A0}/ /g;              # non-breaking spaces

my $LIST_ITEM = qr/^\s*(?:[-*•‣◦▪–]|\d{1,3}[.)]|[a-zA-Z][.)])\s+/;

my @paragraphs;
for my $para (split /\n[ \t]*(?:\n[ \t]*)+/, $text) {
    my @lines = grep { /\S/ } split /\n/, $para;
    next unless @lines;

    # Strip quote/comment prefixes only when *every* line carries one.
    my $prefix = qr/^\s*(?:(?:>\s?)+|\/\/+\s?|#+\s?)/;
    if (!grep { $_ !~ $prefix } @lines) {
        s/$prefix// for @lines;
    }

    my @segments;
    for my $line (@lines) {
        $line =~ s/^\s+|\s+$//g;
        next if $line eq '';

        if (!@segments || $line =~ $LIST_ITEM) {
            push @segments, $line;
        } elsif ($segments[-1] =~ /\w-$/ && $line =~ /^\p{Ll}/) {
            $segments[-1] =~ s/-$//;
            $segments[-1] .= $line;
        } else {
            $segments[-1] .= " $line";
        }
    }

    for (@segments) {
        s/[ \t]+/ /g;
        $_ .= '.' unless /[.!?:;…,"'”’)\]]$/;
    }
    push @paragraphs, join("\n", @segments);
}

print join("\n\n", @paragraphs), "\n" if @paragraphs;
