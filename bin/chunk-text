#!/usr/bin/perl
# chunk-text — split cleaned text into TTS requests, NUL-separated.
#
# Ollama's /v1/audio/speech rejects input over 4096 chars, and every chunk
# boundary costs ~1s of afplay start/stop silence. So:
#   - chunk 1 is just the first sentence (after a one-line title: title + first sentence)
#     => speech starts almost immediately
#   - later chunks pack whole paragraphs up to MAX chars => gaps land on paragraph breaks
#   - oversized paragraphs fall back to sentence, then word boundaries, then hard cuts
#
# Usage: chunk-text [MAX]   (default 3500)
use strict;
use warnings;
use utf8;

binmode STDIN,  ':encoding(UTF-8)';
binmode STDOUT, ':encoding(UTF-8)';

my $MAX = shift // 3500;

local $/;
my $text = <STDIN> // '';
my @paragraphs = grep { /\S/ } split /\n\s*\n/, $text;
exit 0 unless @paragraphs;

# Split at . ! ? … followed by whitespace, then glue back pieces that ended on an
# abbreviation ("Dr.", "e.g.") or an initial ("J."), which aren't sentence ends.
my $ABBREV = qr/(?:^|\s)(?:(?i:mr|mrs|ms|dr|prof|sr|jr|st|vs|cf|fig|e\.g|i\.e)|\p{Lu})\.$/;
sub sentences {
    my @out;
    for my $s (split /(?<=[.!?…])\s+(?=\S)/, shift) {
        if (@out && $out[-1] =~ $ABBREV) { $out[-1] .= " $s" } else { push @out, $s }
    }
    return @out;
}

# Break one over-long piece into <= $MAX parts at sentence, then word, boundaries.
sub split_long {
    my ($piece) = @_;
    return ($piece) if length $piece <= $MAX;
    my @parts = ('');
    for my $s (sentences($piece)) {
        my @words = length $s > $MAX ? split(/\s+/, $s) : ($s);
        # A single token longer than $MAX (base64, URLs) is cut into $MAX-sized pieces.
        @words = map { length($_) > $MAX ? /(.{1,$MAX})/gs : $_ } @words;
        for my $w (@words) {
            if (length($parts[-1]) + length($w) + 1 > $MAX && length $parts[-1]) {
                push @parts, $w;
            } else {
                $parts[-1] .= (length $parts[-1] ? ' ' : '') . $w;
            }
        }
    }
    return @parts;
}

my @chunks;

# Fast start: speak the first sentence on its own.
my ($first, @rest) = sentences($paragraphs[0]);
if (@rest && length $first <= $MAX) {
    push @chunks, $first;
    $paragraphs[0] = join ' ', @rest;
} elsif (!@rest && @paragraphs > 1) {
    # A title or one-line intro: on its own it plays ~2 s, shorter than synthesizing
    # the next full chunk, so pair it with the first sentence of the body.
    my ($next, @more) = sentences($paragraphs[1]);
    if (length("$first\n\n$next") <= $MAX) {
        push @chunks, "$first\n\n$next";
        splice @paragraphs, 0, 1;
        if (@more) { $paragraphs[0] = join ' ', @more } else { shift @paragraphs }
    }
}

my $current = '';
for my $p (map { split_long($_) } @paragraphs) {
    if (length $current && length($current) + length($p) + 2 > $MAX) {
        push @chunks, $current;
        $current = '';
    }
    $current .= (length $current ? "\n\n" : '') . $p;
}
push @chunks, $current if length $current;

print map { "$_\0" } @chunks;
