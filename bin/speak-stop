#!/bin/zsh
# speak-stop — stop whatever speak-selection is currently reading.
# Exit 0 if something was stopped, 1 if nothing was playing.

STATE=$HOME/Library/Caches/phonon-reader
PIDFILE=$STATE/pid

[[ -r $PIDFILE ]] || { rm -rf $STATE/run.*(N); exit 1 }
pid=$(<$PIDFILE)
rm -f $PIDFILE

# Signal it only if it's still our worker: a stale pid file (worker killed
# without cleanup) can point at a reused pid that belongs to something else.
if kill -0 $pid 2>/dev/null &&
   [[ $(ps -p $pid -o command= 2>/dev/null) == *speak-selection*' -W '* ]]; then
  # Freeze the worker so it can't spawn the next afplay, kill its children, then it.
  kill -STOP $pid 2>/dev/null
  pkill -P $pid 2>/dev/null
  kill -KILL $pid 2>/dev/null
  rm -rf $STATE/run.*(N)
  exit 0
fi
rm -rf $STATE/run.*(N)
exit 1
